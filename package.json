{
  "name": "evalcheck",
  "version": "0.1.0",
  "description": "Deterministic, rule-based regression testing for AI-powered HTTP endpoints. No LLM calls, no judge models.",
  "keywords": [
    "ai",
    "eval",
    "evaluation",
    "testing",
    "regression",
    "llm",
    "deterministic",
    "grader"
  ],
  "license": "MIT",
  "author": "Zahid Hasan",
  "homepage": "https://github.com/zahidhasann88/evalcheck#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zahidhasann88/evalcheck.git"
  },
  "bugs": {
    "url": "https://github.com/zahidhasann88/evalcheck/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@12.11.2",
  "bin": {
    "evalcheck": "dist/cli/index.js"
  },
  "main": "./dist/core/index.js",
  "module": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./suite.schema.json": "./dist/suite.schema.json",
    "./config.schema.json": "./dist/config.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup && node dist/cli/index.js schema --out dist/suite.schema.json && node dist/cli/index.js schema --config --out dist/config.schema.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:slow": "EVALCHECK_SLOW=1 vitest run",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^15.0.0",
    "undici": "^8.12.3",
    "yaml": "^2.6.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^3.3.3 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@huggingface/transformers": "^4.3.1",
    "@types/node": "^26.6.5",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.13.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "onnxruntime-node",
      "sharp",
      "protobufjs"
    ]
  }
}
